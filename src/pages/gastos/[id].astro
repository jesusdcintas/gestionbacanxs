---
import AppLayout from '../../layouts/AppLayout.astro';
import GastoForm from '../../components/gastos/GastoForm.tsx';
import { getGasto, subirFacturaGasto, updateGasto } from '../../services/gastos';
import { getEventos } from '../../services/eventos';
import { getProfiles } from '../../services/profiles';

const { id } = Astro.params;
const returnToRaw = Astro.url.searchParams.get('return_to') ?? '/gastos';
const returnTo = returnToRaw.startsWith('/') ? returnToRaw : '/gastos';
const visibleRaw = Astro.url.searchParams.get('visible_gastos') ?? '';

const visibleFromReturnTo = (() => {
  try {
    const parsed = new URL(returnTo, 'http://local');
    return parsed.searchParams.get('visible_gastos') ?? '';
  } catch {
    return '';
  }
})();

const visibleGastosIds = (visibleRaw || visibleFromReturnTo)
  .split(',')
  .map((value) => value.trim())
  .filter(Boolean);

const buildReturnToFor = (targetId: string) => {
  try {
    const parsed = new URL(returnTo, 'http://local');
    parsed.searchParams.set('open_gasto', targetId);
    if (visibleGastosIds.length > 0) {
      parsed.searchParams.set('visible_gastos', visibleGastosIds.join(','));
    }
    const qs = parsed.searchParams.toString();
    return `${parsed.pathname}${qs ? `?${qs}` : ''}`;
  } catch {
    return returnTo;
  }
};

const currentReturnTo = buildReturnToFor(id ?? '');
const currentIndex = id ? visibleGastosIds.indexOf(id) : -1;
const gastoAnteriorId = currentIndex > 0 ? visibleGastosIds[currentIndex - 1] : null;
const gastoSiguienteId = currentIndex >= 0 && currentIndex < visibleGastosIds.length - 1
  ? visibleGastosIds[currentIndex + 1]
  : null;

const buildEditHref = (targetId: string) => {
  const search = new URLSearchParams();
  search.set('return_to', buildReturnToFor(targetId));
  if (visibleGastosIds.length > 0) {
    search.set('visible_gastos', visibleGastosIds.join(','));
  }
  return `/gastos/${targetId}?${search.toString()}`;
};

if (!id) {
  return Astro.redirect('/gastos');
}

let gasto;
try {
  gasto = await getGasto(Astro, id);
} catch (error) {
  console.error('Error loading gasto:', error);
  return Astro.redirect('/gastos');
}

const eventos = await getEventos(Astro);
const profiles = await getProfiles(Astro);

// Handle form submission
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const formReturnToRaw = formData.get('return_to')?.toString() ?? currentReturnTo;
    const formReturnTo = formReturnToRaw.startsWith('/') ? formReturnToRaw : '/gastos';
    const formaPago = formData.get('forma_pago')?.toString().trim() || null;
    const tipoFactura = formData.get('tipo_factura')?.toString().trim() || null;
    const facturaRaw = formData.get('factura');
    const facturaFile = facturaRaw instanceof File && facturaRaw.size > 0 ? facturaRaw : null;
    
    const gastoData = {
      concepto: formData.get('concepto')?.toString() || '',
      cantidad: parseFloat(formData.get('cantidad')?.toString() || '0'),
      categoria: formData.get('categoria')?.toString() || 'Otros',
      tipo_gasto: (formData.get('tipo_gasto')?.toString() || gasto.tipo_gasto || 'inversion_empresa') as 'directo_evento' | 'inversion_empresa',
      fecha: formData.get('fecha')?.toString() || new Date().toISOString().split('T')[0],
      evento_id: formData.has('evento_id') && formData.get('evento_id') ? formData.get('evento_id')!.toString() : null,
      forma_pago: formaPago as 'tarjeta' | 'transferencia' | 'efectivo' | null,
      tipo_factura: tipoFactura as 'A' | 'B' | null,
      factura_path: gasto.factura_path,
      reembolsado: formData.get('reembolsado') === 'on',
    };

    const fuentes = [
      ...profiles.map((p) => ({
        socio_id: p.id,
        cantidad: parseFloat(formData.get(`fuente_${p.id}`)?.toString() || '0'),
      })),
      {
        socio_id: null,
        cantidad: parseFloat(formData.get('fuente_fondo')?.toString() || '0'),
      },
    ];

    console.log('Datos del gasto a actualizar:', JSON.stringify(gastoData, null, 2));
    
    const gastoActualizado = await updateGasto(Astro, id, gastoData, fuentes);

    if (facturaFile) {
      await subirFacturaGasto(Astro, id, facturaFile, gastoActualizado.factura_path ?? gasto.factura_path);
    }

    return Astro.redirect(formReturnTo);
  } catch (error) {
    console.error('Error updating gasto:', error);
    const errorMessage = error instanceof Error ? error.message : 'Error desconocido';
    return new Response(
      `<html><body><h1>Error al actualizar gasto</h1><pre>${errorMessage}</pre><a href="/gastos/${id}?return_to=${encodeURIComponent(currentReturnTo)}">Volver</a></body></html>`,
      { status: 500, headers: { 'Content-Type': 'text/html' } }
    );
  }
}
---

<AppLayout title={`Editar ${gasto.concepto}`}>
  <div class="max-w-3xl mx-auto space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
      <h1 class="text-3xl uppercase italic" style="font-family: 'Archivo Black', sans-serif;">Editar gasto</h1>
      <p class="text-text-secondary mt-1">Modifica los detalles del gasto</p>
      </div>
      {visibleGastosIds.length > 1 && (
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {gastoAnteriorId ? (
            <a href={buildEditHref(gastoAnteriorId)} class="inline-flex h-10 items-center justify-center rounded-xs border border-border-strong bg-transparent px-4 text-sm text-text-primary transition-colors duration-150 hover:border-text-primary/40 hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a]">
              ← Gasto anterior
            </a>
          ) : (
            <span class="inline-flex h-10 cursor-not-allowed items-center justify-center rounded-xs border border-border px-4 text-sm text-text-secondary opacity-50">
              ← Gasto anterior
            </span>
          )}
          {gastoSiguienteId ? (
            <a href={buildEditHref(gastoSiguienteId)} class="inline-flex h-10 items-center justify-center rounded-xs border border-border-strong bg-transparent px-4 text-sm text-text-primary transition-colors duration-150 hover:border-text-primary/40 hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a]">
              Gasto siguiente →
            </a>
          ) : (
            <span class="inline-flex h-10 cursor-not-allowed items-center justify-center rounded-xs border border-border px-4 text-sm text-text-secondary opacity-50">
              Gasto siguiente →
            </span>
          )}
        </div>
      )}
    </div>

    <GastoForm gasto={gasto} eventos={eventos} profiles={profiles} cancelTo={currentReturnTo} client:load />
  </div>
</AppLayout>
