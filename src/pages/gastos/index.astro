---
import AppLayout from '../../layouts/AppLayout.astro';
import GastosDashboard from '../../components/gastos/GastosDashboard.tsx';
import { Button } from '../../components/ui/Button.tsx';
import { Plus } from 'lucide-react';
import { getGastos } from '../../services/gastos';
import { getProfiles } from '../../services/profiles';

type Filtro = 'todos' | 'generales' | 'eventos';
type TipoFiltro = 'todos' | 'directo_evento' | 'inversion_empresa' | 'consumible';

const filtroRaw = Astro.url.searchParams.get('filtro') ?? 'todos';
const filtro: Filtro = (['todos', 'generales', 'eventos'] as Filtro[]).includes(
  filtroRaw as Filtro,
)
  ? (filtroRaw as Filtro)
  : 'todos';

const tipoRaw = Astro.url.searchParams.get('tipo') ?? 'todos';
const tipoFiltro: TipoFiltro = (
  ['todos', 'directo_evento', 'inversion_empresa', 'consumible'] as TipoFiltro[]
).includes(tipoRaw as TipoFiltro)
  ? (tipoRaw as TipoFiltro)
  : 'todos';

const todos = await getGastos(Astro);
const profiles = await getProfiles(Astro);

const emptyMessages: Record<Filtro, string> = {
  todos: 'No hay gastos registrados. Crea tu primer gasto.',
  generales: 'No hay gastos generales (sin evento asociado).',
  eventos: 'No hay gastos asociados a eventos.',
};
---

<AppLayout title="Gastos">
  <div class="space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-[11px] uppercase tracking-[0.24em] text-text-secondary">Gastos</p>
        <h1 class="mt-2 text-3xl uppercase italic" style="font-family: 'Archivo Black', sans-serif;">Gastos</h1>
        <p class="text-text-secondary mt-1">Registra y filtra tus salidas de dinero.</p>
      </div>
      <a href="/gastos/nuevo">
        <Button variant="primary" client:load>
          <Plus size={20} />
          Nuevo Gasto
        </Button>
      </a>
    </div>

    <GastosDashboard todosIniciales={todos} profiles={profiles} filtro={filtro} tipoFiltro={tipoFiltro} emptyMessage={emptyMessages[filtro]} client:load />
  </div>
</AppLayout>
