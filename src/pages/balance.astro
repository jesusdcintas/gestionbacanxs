---
import AppLayout from '../layouts/AppLayout.astro';
import { Card, CardHeader, CardTitle, CardContent } from '../components/ui/Card.tsx';
import { StampLabel } from '../components/ui/StampLabel.tsx';
import MonthlyChart from '../components/balance/MonthlyChart.tsx';
import CategoryChart from '../components/balance/CategoryChart.tsx';
import BalanceSociosTable from '../components/balance/BalanceSociosTable.tsx';
import BalanceLiquidacionPanel from '../components/balance/BalanceLiquidacionPanel.tsx';
import BalancePeriodoPanel from '../components/balance/BalancePeriodoPanel.tsx';
import {
  getBalanceData,
  getCategoryData,
  getBalanceSocios,
  getRepartosDetallePorSocio,
  getPendientesDetallePorSocio,
} from '../services/balance';

const [monthlyDataAll, monthlyData6m, categoryData, balanceSocios, repartosDetallePorSocio, pendientesDetallePorSocio] = await Promise.all([
  getBalanceData(Astro),
  getBalanceData(Astro, 6),
  getCategoryData(Astro),
  getBalanceSocios(Astro),
  getRepartosDetallePorSocio(Astro),
  getPendientesDetallePorSocio(Astro),
]);

const formatCurrency = (value: number) =>
  new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(value);
---

<AppLayout title="Balance">
  <div class="space-y-8">
    <!-- Encabezado -->
    <div>
      <p class="text-[11px] uppercase tracking-[0.24em] text-text-secondary">Balance</p>
      <h1
        class="mt-2 text-2xl uppercase italic sm:text-3xl"
        style="font-family: 'Archivo Black', sans-serif;"
      >
        Balance financiero
      </h1>
      <p class="text-text-secondary mt-1">
        Ingresos y gastos en el tiempo, pendiente de reembolso entre socios y repartos por eventos trabajados.
      </p>
    </div>

    <BalancePeriodoPanel monthlyData={monthlyDataAll} client:load />

    <!-- Balance entre socios -->
    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <StampLabel rotate="left" variant="accent">Socios</StampLabel>
        <h2
          class="text-xl uppercase italic"
          style="font-family: 'Archivo Black', sans-serif;"
        >
          Balance entre socios
        </h2>
      </div>

      <Card>
        <CardContent>
          <BalanceSociosTable
            balances={balanceSocios}
            repartosDetallePorSocio={repartosDetallePorSocio}
            pendientesDetallePorSocio={pendientesDetallePorSocio}
            client:load
          />
        </CardContent>
      </Card>

      <Card>
        <CardContent>
          <BalanceLiquidacionPanel balances={balanceSocios} client:load />
        </CardContent>
      </Card>
    </div>

    <!-- Histórico mensual y categorías -->
    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <StampLabel rotate="left" variant="outline">Histórico</StampLabel>
        <h2
          class="text-xl uppercase italic"
          style="font-family: 'Archivo Black', sans-serif;"
        >
          Evolución y categorías
        </h2>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>Ingresos vs gastos · Últimos 6 meses</CardTitle>
        </CardHeader>
        <CardContent>
          <MonthlyChart data={monthlyData6m} client:load />
        </CardContent>
      </Card>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <Card>
          <CardHeader>
            <CardTitle>Gastos por categoría</CardTitle>
          </CardHeader>
          <CardContent>
            <CategoryChart data={categoryData} client:load />
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Resumen por categoría</CardTitle>
          </CardHeader>
          <CardContent>
            {categoryData.length === 0 ? (
              <p class="text-sm text-text-secondary text-center py-8">
                Aún no hay gastos registrados.
              </p>
            ) : (
              <div class="space-y-1">
                {categoryData.map((cat) => (
                  <div
                    class="flex items-center justify-between py-2 border-b border-border last:border-0"
                  >
                    <span class="text-[11px] uppercase tracking-[0.08em] text-text-primary">
                      {cat.categoria}
                    </span>
                    <div class="flex items-center gap-3">
                      <div
                        class="text-xs text-text-secondary"
                        style="font-family: 'JetBrains Mono', monospace;"
                      >
                        {cat.porcentaje.toFixed(1)}%
                      </div>
                      <div
                        class="text-sm text-danger text-right"
                        style="font-family: 'JetBrains Mono', monospace;"
                      >
                        −{formatCurrency(cat.total)}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</AppLayout>
