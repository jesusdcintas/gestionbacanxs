---
import AppLayout from '../../layouts/AppLayout.astro';
import IngresoForm from '../../components/ingresos/IngresoForm.tsx';
import { createIngreso } from '../../services/ingresos';
import { getEventos } from '../../services/eventos';
import { getProfiles } from '../../services/profiles';

const eventos = await getEventos(Astro);
const profiles = await getProfiles(Astro);

// Handle form submission
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const eventoId = formData.get('evento_id')?.toString() || '';
    const metodoPago = (formData.get('metodo_pago')?.toString() as 'efectivo' | 'banco' | null) || 'banco';

    if (!eventoId) {
      throw new Error('Debes seleccionar un evento para registrar el ingreso');
    }
    
    const ingresoData = {
      concepto: formData.get('concepto')?.toString() || '',
      cantidad: parseFloat(formData.get('cantidad')?.toString() || '0'),
      fecha: formData.get('fecha')?.toString() || new Date().toISOString().split('T')[0],
      evento_id: eventoId,
      recibido_por: formData.get('recibido_por')?.toString() || null,
      metodo_pago: metodoPago,
    };

    if (!ingresoData.recibido_por) {
      throw new Error('Debes seleccionar quién cobró el ingreso');
    }

    await createIngreso(Astro, ingresoData);
    return Astro.redirect('/ingresos');
  } catch (error) {
    console.error('Error creating ingreso:', error);
  }
}
---

<AppLayout title="Nuevo Ingreso">
  <div class="max-w-3xl mx-auto space-y-6">
    <div>
      <h1 class="text-3xl uppercase italic" style="font-family: 'Archivo Black', sans-serif;">Nuevo ingreso</h1>
      <p class="text-text-secondary mt-1">Registra una entrada de dinero</p>
    </div>

    <IngresoForm eventos={eventos} profiles={profiles} client:load />
  </div>
</AppLayout>
