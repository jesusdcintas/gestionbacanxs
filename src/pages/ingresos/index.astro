---
import AppLayout from '../../layouts/AppLayout.astro';
import IngresosTable from '../../components/ingresos/IngresosTable.tsx';
import { Button } from '../../components/ui/Button.tsx';
import { Card } from '../../components/ui/Card.tsx';
import { Plus } from 'lucide-react';
import { getIngresos } from '../../services/ingresos';
import { getProfiles } from '../../services/profiles';

const ingresos = await getIngresos(Astro);
const profiles = await getProfiles(Astro);
---

<AppLayout title="Ingresos">
  <div class="space-y-6">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-2xl uppercase italic sm:text-3xl" style="font-family: 'Archivo Black', sans-serif;">Ingresos</h1>
        <p class="text-text-secondary mt-1">Registra tus entradas de dinero</p>
      </div>
      <a href="/ingresos/nuevo" class="w-full sm:w-auto">
        <Button variant="primary" client:load>
          <Plus size={20} />
          Nuevo Ingreso
        </Button>
      </a>
    </div>

    <Card>
      <IngresosTable ingresos={ingresos} profiles={profiles} editBasePath="/ingresos" client:load />
    </Card>
  </div>
</AppLayout>
