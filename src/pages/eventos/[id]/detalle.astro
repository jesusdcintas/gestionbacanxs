---
import AppLayout from '../../../layouts/AppLayout.astro';
import PagosEventoSection from '../../../components/eventos/PagosEventoSection.tsx';
import CobroYRepartoAhora from '../../../components/eventos/CobroYRepartoAhora.tsx';
import FinanzasEventoPanel from '../../../components/eventos/FinanzasEventoPanel.tsx';
import DeleteEventoButton from '../../../components/eventos/DeleteEventoButton.tsx';
import { Card } from '../../../components/ui/Card.tsx';
import { StampLabel } from '../../../components/ui/StampLabel.tsx';
import { getEventoCompleto, getEventos } from '../../../services/eventos';
import { getPagosByEvento, getTotalPagadoEvento } from '../../../services/pagos';
import { getGastosByEvento, getTotalGastosEvento } from '../../../services/gastos';
import { getRepartosByEvento } from '../../../services/repartos';
import { getProfiles } from '../../../services/profiles';
import {
  IVA_POR_DEFECTO,
  calcularBaseImponible,
  calcularIVA,
  calcularIngresoNeto,
  calcularRetencionIRPF,
} from '../../../utils/finanzas';
import { getEstadoStamp, getEstadoVisible, getEstadoVisibleLabel } from '../../../utils/eventoEstado';

const { id } = Astro.params;
const initialOpenGastoId = Astro.url.searchParams.get('open_gasto');
const initialVisibleGastosIds = (Astro.url.searchParams.get('visible_gastos') ?? '')
  .split(',')
  .map((value) => value.trim())
  .filter(Boolean);

if (!id) {
  return Astro.redirect('/eventos');
}

let evento: any;
let pagos: any[] = [];
let gastos: any[] = [];
let repartos: any[] = [];
let socios: any[] = [];
let eventoAnteriorId: string | null = null;
let eventoSiguienteId: string | null = null;

try {
  const [eventoCompleto, pagosEvento, gastosEvento, repartosEvento, sociosEvento, eventosLista] = await Promise.all([
    getEventoCompleto(Astro, id),
    getPagosByEvento(Astro, id),
    getGastosByEvento(Astro, id),
    getRepartosByEvento(Astro, id),
    getProfiles(Astro),
    getEventos(Astro),
  ]);

  evento = eventoCompleto;
  pagos = pagosEvento;
  gastos = gastosEvento;
  repartos = repartosEvento;
  socios = sociosEvento;

  const indiceActual = eventosLista.findIndex((e) => e.id === id);
  if (indiceActual !== -1) {
    eventoAnteriorId = eventosLista[indiceActual - 1]?.id ?? null;
    eventoSiguienteId = eventosLista[indiceActual + 1]?.id ?? null;
  }
} catch (error) {
  console.error('Error loading evento detalle:', error);
  return Astro.redirect('/eventos');
}

const presupuesto = Number(evento.presupuesto);
const ingresoNeto = calcularIngresoNeto(presupuesto, evento.con_factura, Number(evento.retencion_irpf));
const ivaImporte = calcularIVA(presupuesto, evento.con_factura, IVA_POR_DEFECTO);
const baseImponible = calcularBaseImponible(presupuesto, evento.con_factura, IVA_POR_DEFECTO);
const retencionImporte = calcularRetencionIRPF(presupuesto, evento.con_factura, Number(evento.retencion_irpf));
const totalPagado = await getTotalPagadoEvento(Astro, id);
const totalGastos = await getTotalGastosEvento(Astro, id);

const repartosFormateados = repartos.map((r) => ({
  id: r.id,
  socio_id: r.socio_id,
  nombre: r.socio_id ? (r.profiles?.nombre || 'Desconocido') : 'Fondo de empresa',
  cantidad: Number(r.cantidad),
  fecha: r.fecha,
  concepto: r.concepto,
  created_at: r.created_at,
}));

const totalRepartido = repartosFormateados.reduce((sum, r) => sum + Number(r.cantidad), 0);
const pendienteReparto = ingresoNeto - totalGastos - totalRepartido;
const repartoCompleto = pendienteReparto <= 0.01;

const estadoVisible = getEstadoVisible(evento.estado_trabajo, evento.estado_financiero);
const estadoStamp = getEstadoStamp(estadoVisible);
---

<AppLayout title={evento.nombre}>
  <div class="max-w-6xl mx-auto space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <div class="mb-2 flex flex-wrap items-center gap-2 sm:gap-3">
          <h1 class="text-2xl uppercase italic sm:text-3xl" style="font-family: 'Archivo Black', sans-serif;">{evento.nombre}</h1>
          <StampLabel variant={estadoStamp.variant} rotate={estadoStamp.rotate}>
            {getEstadoVisibleLabel(estadoVisible)}
          </StampLabel>
          <StampLabel variant={repartoCompleto ? 'accent' : 'danger'} rotate="none">
            {repartoCompleto ? 'Reparto completo' : 'Reparto pendiente'}
          </StampLabel>
        </div>
        <p class="text-text-secondary" style="font-family: 'JetBrains Mono', monospace;">
          {evento.fecha} {evento.lugar ? `· ${evento.lugar}` : ''}
        </p>
      </div>
      <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:flex">
        {eventoAnteriorId ? (
          <a href={`/eventos/${eventoAnteriorId}/detalle`} class="inline-flex h-10 w-full items-center justify-center rounded-xs border border-border-strong bg-transparent px-4 text-sm text-text-primary transition-colors duration-150 hover:border-text-primary/40 hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a] xl:w-auto">
            ← Evento anterior
          </a>
        ) : (
          <span class="inline-flex h-10 w-full cursor-not-allowed items-center justify-center rounded-xs border border-border text-sm text-text-secondary opacity-50 xl:w-auto">
            ← Evento anterior
          </span>
        )}
        {eventoSiguienteId ? (
          <a href={`/eventos/${eventoSiguienteId}/detalle`} class="inline-flex h-10 w-full items-center justify-center rounded-xs border border-border-strong bg-transparent px-4 text-sm text-text-primary transition-colors duration-150 hover:border-text-primary/40 hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a] xl:w-auto">
            Evento siguiente →
          </a>
        ) : (
          <span class="inline-flex h-10 w-full cursor-not-allowed items-center justify-center rounded-xs border border-border text-sm text-text-secondary opacity-50 xl:w-auto">
            Evento siguiente →
          </span>
        )}
        <a href={`/eventos/${id}`} class="inline-flex h-10 w-full items-center justify-center rounded-xs border border-border-strong bg-transparent px-4 text-sm text-text-primary transition-colors duration-150 hover:border-text-primary/40 hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a] xl:w-auto">
          Editar evento
        </a>
        <DeleteEventoButton eventoId={id} client:load />
        <a href="/eventos" class="inline-flex h-10 w-full items-center justify-center rounded-xs border border-border-strong bg-transparent px-4 text-sm text-text-primary transition-colors duration-150 hover:border-text-primary/40 hover:bg-surface-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-[#0a0a0a] xl:w-auto">
          ← Volver
        </a>
      </div>
    </div>

    <Card>
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <StampLabel rotate="none">Estados del evento</StampLabel>
          <p class="mt-2 text-sm text-text-secondary">Puedes actualizar trabajo y cobro desde esta vista.</p>
        </div>
        <form method="POST" action={`/api/eventos/${id}/estado`} class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 md:w-auto md:flex md:items-end">
          <input type="hidden" name="redirect_to" value={`/eventos/${id}/detalle`} />

          <label class="flex flex-col gap-1">
            <span class="text-[11px] uppercase tracking-[0.08em] text-text-secondary">Trabajo</span>
            <select
              name="estado_trabajo"
              class="w-full min-w-0 border border-border bg-[#0a0a0a] px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none md:min-w-45"
            >
              <option value="confirmado" selected={evento.estado_trabajo === 'confirmado'}>Confirmado</option>
              <option value="realizado" selected={evento.estado_trabajo === 'realizado'}>Realizado</option>
              <option value="cancelado" selected={evento.estado_trabajo === 'cancelado'}>Cancelado</option>
            </select>
          </label>

          <label class="flex flex-col gap-1">
            <span class="text-[11px] uppercase tracking-[0.08em] text-text-secondary">Financiero</span>
            <select
              name="estado_financiero"
              class="w-full min-w-0 border border-border bg-[#0a0a0a] px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none md:min-w-45"
            >
              <option value="no_pagado" selected={evento.estado_financiero === 'no_pagado'}>No pagado</option>
              <option value="parcialmente_pagado" selected={evento.estado_financiero === 'parcialmente_pagado'}>Parcialmente pagado</option>
              <option value="pagado" selected={evento.estado_financiero === 'pagado'}>Pagado</option>
            </select>
          </label>

          <button
            type="submit"
            class="h-10.5 w-full border border-accent bg-accent px-4 text-sm font-bold text-[#0a0a0a] transition-colors hover:bg-accent-hover sm:col-span-2 md:w-auto"
          >
            Guardar estados
          </button>
        </form>
      </div>
    </Card>

    <Card>
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <StampLabel rotate="none">Parámetros fiscales</StampLabel>
          <p class="mt-2 text-sm text-text-secondary">Configura si es facturable y el porcentaje de retención IRPF.</p>
        </div>
        <form method="POST" action={`/api/eventos/${id}/facturacion`} class="grid w-full grid-cols-1 gap-3 sm:grid-cols-2 md:w-auto md:flex md:items-end">
          <input type="hidden" name="redirect_to" value={`/eventos/${id}/detalle`} />

          <label class="flex h-10.5 w-full items-center gap-2 border border-border bg-[#0a0a0a] px-3 sm:w-auto">
            <input
              type="checkbox"
              name="con_factura"
              value="true"
              checked={evento.con_factura}
              class="h-4 w-4 border-border-strong bg-[#0a0a0a] text-accent accent-accent focus:ring-accent"
            />
            <span class="text-sm text-text-primary">Facturable</span>
          </label>

          <label class="flex flex-col gap-1">
            <span class="text-[11px] uppercase tracking-[0.08em] text-text-secondary">Retención IRPF (%)</span>
            <input
              type="number"
              name="retencion_irpf"
              min="0"
              max="100"
              step="0.01"
              value={Number(evento.retencion_irpf).toFixed(2)}
              class="w-full min-w-0 border border-border bg-[#0a0a0a] px-3 py-2 text-sm text-text-primary focus:border-accent focus:outline-none md:min-w-45"
            />
          </label>

          <button
            type="submit"
            class="h-10.5 w-full border border-accent bg-accent px-4 text-sm font-bold text-[#0a0a0a] transition-colors hover:bg-accent-hover sm:col-span-2 md:w-auto"
          >
            Guardar IRPF
          </button>
        </form>
      </div>
    </Card>

    {(evento.cliente || evento.observaciones) && (
      <Card>
        <StampLabel rotate="right">Información adicional</StampLabel>
        <div class="space-y-2 text-sm mt-3">
          {evento.cliente && (
            <div>
              <span class="text-[11px] uppercase tracking-[0.08em] text-text-secondary">Cliente:</span>
              <span class="ml-2 text-text-primary">{evento.cliente}</span>
            </div>
          )}
          {evento.observaciones && (
            <div>
              <span class="text-[11px] uppercase tracking-[0.08em] text-text-secondary">Observaciones:</span>
              <p class="mt-1 text-text-primary">{evento.observaciones}</p>
            </div>
          )}
        </div>
      </Card>
    )}

    <CobroYRepartoAhora eventoId={id} profiles={socios} socios={socios} client:load />

    <PagosEventoSection eventoId={id} pagos={pagos} profiles={socios} client:load />

    <FinanzasEventoPanel
      eventoId={id}
      eventoNombre={evento.nombre}
      presupuesto={presupuesto}
      ingresoNeto={ingresoNeto}
      ivaImporte={ivaImporte}
      baseImponible={baseImponible}
      retencionImporte={retencionImporte}
      totalPagado={totalPagado}
      totalGastosInicial={totalGastos}
      conFactura={evento.con_factura}
      retencionIrpf={Number(evento.retencion_irpf)}
      gastosIniciales={gastos}
      socios={socios}
      repartosIniciales={repartosFormateados}
      initialOpenGastoId={initialOpenGastoId}
      initialVisibleGastosIds={initialVisibleGastosIds}
      client:load
    />
  </div>
</AppLayout>